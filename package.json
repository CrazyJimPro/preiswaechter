{
  "name": "preiswaechter",
  "productName": "Preiswächter",
  "version": "1.1.0",
  "description": "Verfolgt Produktpreise in Online-Shops, speichert den Preisverlauf und meldet Preissenkungen",
  "type": "module",
  "main": "src/main/main.js",
  "desktopName": "preiswaechter.desktop",
  "author": "CrazyJimPro <c.jung2811@web.de>",
  "license": "MIT",
  "homepage": "https://github.com/CrazyJimPro/preiswaechter",
  "repository": "github:CrazyJimPro/preiswaechter",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "test:app": "node tests/app/run.mjs",
    "predist:linux": "node node_modules/electron/install.js",
    "dist:linux": "electron-builder --linux AppImage --publish never -c.electronDist=node_modules/electron/dist",
    "predist:win": "node node_modules/electron/install.js",
    "dist:win": "electron-builder --win nsis --publish never -c.electronDist=node_modules/electron/dist"
  },
  "build": {
    "appId": "de.crazyjimpro.preiswaechter",
    "productName": "Preiswaechter",
    "artifactName": "Preiswaechter-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/icon.png",
      "executableName": "preiswaechter",
      "synopsis": "Produktpreise verfolgen",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Preiswächter",
          "Comment": "Produktpreise verfolgen",
          "Keywords": "Preis;Preisverlauf;Shop;",
          "StartupWMClass": "preiswaechter"
        }
      }
    },
    "appImage": {
      "artifactName": "Preiswaechter-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "executableName": "Preiswaechter"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "PreiswaechterSetup.${ext}",
      "shortcutName": "Preiswächter",
      "uninstallDisplayName": "Preiswächter",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "de_DE"
      ],
      "language": "1031",
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "jsdom": "^25.0.1",
    "puppeteer-core": "^24.43.1"
  }
}
